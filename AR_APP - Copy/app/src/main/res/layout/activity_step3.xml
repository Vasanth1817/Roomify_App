<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F7FC" tools:context=".Step3Activity">
    <!--  â•â•â•â•â•â•â•â•â•â•â•â•â•â• TOP: Orange gradient â•â•â•â•â•â•â•â•â•â•â•â•â•â•  -->
    <FrameLayout android:id="@+id/topSection" android:layout_width="0dp" android:layout_height="0dp" android:background="@drawable/bg_tutorial_orange" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/bottomCard" app:layout_constraintHeight_percent="0.50">
        <!--  Skip pill â€“ top right  -->
        <TextView android:id="@+id/btnSkip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginEnd="16dp" android:layout_marginTop="48dp" android:text="Skip" android:textColor="#FFFFFF" android:textSize="13sp" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/bg_skip_pill" android:fontFamily="@font/poppins_medium"/>
        <!--  â”€â”€ Phone illustration with floating badges â”€â”€  -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="36dp" android:paddingBottom="8dp">
            <!--  Phone outer frame  -->
            <FrameLayout android:id="@+id/phoneFrame" android:layout_width="130dp" android:layout_height="190dp" android:layout_centerInParent="true" android:background="@drawable/bg_phone_frame" android:padding="6dp">
                <!--  Phone screen with room image  -->
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/phone_screen_room" android:scaleType="centerCrop" android:background="@drawable/bg_phone_screen"/>
                <!--  AR icon overlay on screen  -->
                <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:layout_marginBottom="20dp" android:background="@drawable/bg_ar_icon_pill">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_ar_camera" android:tint="#FFFFFF"/>
                </FrameLayout>
                <!--  "PICTURE TO CHAIR" text overlay at bottom of screen  -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:text="PICTURE TO CHAIR" android:textColor="#FFFFFF" android:textSize="7sp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="#99000000" android:letterSpacing="0.1" android:fontFamily="@font/poppins_medium"/>
            </FrameLayout>
            <!--  â”€â”€ "Design Saved" badge â€“ top right of phone â”€â”€  -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:background="@drawable/bg_badge_white" android:layout_toRightOf="@id/phoneFrame" android:layout_alignTop="@id/phoneFrame" android:layout_marginLeft="-16dp" android:layout_marginTop="16dp" android:elevation="4dp">
                <!--  Green check circle  -->
                <FrameLayout android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/bg_check_circle" android:layout_marginEnd="6dp">
                    <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="center" android:src="@drawable/ic_check"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Design Saved" android:textColor="#1A1A2E" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
            </LinearLayout>
            <!--  â”€â”€ "Share" badge â€“ right middle of phone â”€â”€  -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:background="@drawable/bg_share_badge" android:layout_toRightOf="@id/phoneFrame" android:layout_centerVertical="true" android:layout_marginLeft="-8dp" android:elevation="4dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_share_small" android:layout_marginEnd="5dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share" android:textColor="#1A1A2E" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
            </LinearLayout>
            <!--  â”€â”€ "Shopping List" badge â€“ left middle of phone â”€â”€  -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:background="@drawable/bg_shopping_badge" android:layout_toLeftOf="@id/phoneFrame" android:layout_centerVertical="true" android:layout_marginRight="-8dp" android:elevation="4dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_shopping_list" android:layout_marginEnd="5dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shopping List" android:textColor="#1A1A2E" android:textSize="11sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
    <!--  â•â•â•â•â•â•â•â•â•â•â•â•â•â• BOTTOM: White card â•â•â•â•â•â•â•â•â•â•â•â•â•â•  -->
    <androidx.cardview.widget.CardView android:id="@+id/bottomCard" android:layout_width="0dp" android:layout_height="0dp" app:cardCornerRadius="28dp" app:cardElevation="10dp" app:cardBackgroundColor="#FFFFFF" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintHeight_percent="0.54">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="24dp">
            <!--  STEP 3 orange pill  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STEP 3" android:textColor="#FF8C00" android:textSize="11sp" android:letterSpacing="0.10" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/bg_step3_pill" android:layout_marginBottom="10dp" android:fontFamily="@font/poppins_bold"/>
            <!--  Headline  -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save, Compare &amp;\nExport Your Design" android:textColor="#1A1A2E" android:textSize="24sp" android:textStyle="bold" android:lineSpacingMultiplier="1.15" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_bold"/>
            <!--  Subtitle  -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save designs, use Before &amp; After view, and export shopping lists." android:textColor="#888899" android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="16dp" android:fontFamily="@font/poppins_regular"/>
            <!--  2x2 Feature grid  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <!--  Row 1: Save Design + Compare View  -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <!--  Save Design  -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/bg_feature_card">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_pref_icon" android:layout_marginEnd="10dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_save_design"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save Design" android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>
                    <!--  Compare View  -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/bg_feature_card">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_pref_icon" android:layout_marginEnd="10dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_compare_view"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compare View" android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>
                </LinearLayout>
                <!--  Row 2: Export List + Share Ideas  -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <!--  Export List  -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/bg_feature_card">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_pref_icon" android:layout_marginEnd="10dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_export_list"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Export List" android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>
                    <!--  Share Ideas  -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/bg_feature_card">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_pref_icon" android:layout_marginEnd="10dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_share_ideas"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share Ideas" android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!--  Spacer  -->
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <!--  Page dots: â—‹ â—‹ â—‹ â— (4th active = orange)  -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot_inactive_grey" android:layout_marginEnd="6dp"/>
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot_inactive_grey" android:layout_marginEnd="6dp"/>
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot_inactive_grey" android:layout_marginEnd="6dp"/>
                <!--  active dot â€“ wide orange pill  -->
                <View android:layout_width="24dp" android:layout_height="8dp" android:background="@drawable/bg_dot_active_orange"/>
            </LinearLayout>
            <!--  Start Designing â†’ button (orange-red gradient)  -->
            <Button android:id="@+id/btnStartDesigning" android:layout_width="match_parent" android:layout_height="54dp" android:text="Start Designing â†’" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/bg_start_button" android:fontFamily="@font/poppins_bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
